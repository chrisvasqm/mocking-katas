meta {
  name: Create post
  type: http
  seq: 1
}

post {
  url: {{domain}}/posts
  body: json
  auth: none
}

body:json {
  {
    "username": "mosh",
    "imageUrl": "https://picsum.photos/id/237/1080/1080",
    "caption": "Mocking with Mosh"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("id", res.body.id);
  }
}
